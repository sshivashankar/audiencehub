# Database
DATABASE_URL="postgresql://audiencehub:audiencehub@localhost:5432/audiencehub"
DIRECT_URL="postgresql://audiencehub:audiencehub@localhost:5432/audiencehub"

# Redis
REDIS_URL="redis://localhost:6379"

# API
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
API_PREFIX="/api/v1"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_APP_NAME="AudienceHub"

# JWT
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRATION="24h"
JWT_REFRESH_SECRET="dev-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRATION="30d"

# OAuth - Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# OAuth - Microsoft
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_CALLBACK_URL="http://localhost:3001/api/auth/microsoft/callback"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@audiencehub.com"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="audiencehub-uploads"

# AI Services
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_GENAI_API_KEY="your-google-genai-key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# Session
SESSION_SECRET="dev-session-secret-key-change-in-production"
SESSION_TIMEOUT=86400

# Logging
LOG_LEVEL="debug"
LOG_FORMAT="pretty"

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_REPORTING_ENABLED=true
FEATURE_CUSTOM_DOMAINS_ENABLED=false
